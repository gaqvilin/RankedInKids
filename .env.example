# Copy to .env.local for local development. Nothing here is required:
# without DATABASE_URL the app uses an in-memory store.

# Neon Postgres (role padeladmin_app). Production value lives in Vercel → Settings → Environment Variables.
DATABASE_URL=

# Fallback store if no database (private Vercel Blob). Not used in production.
BLOB_READ_WRITE_TOKEN=

# Rankedin ids (comma separated) who may read /feedback. Default: R000385768.
FEEDBACK_ADMINS=

# Set to 0 to hide adult leagues (SPL). Default: shown.
VITE_ADULT_LEAGUES=
